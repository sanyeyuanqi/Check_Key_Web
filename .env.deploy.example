POSTGRES_USER=root
POSTGRES_PASSWORD=change-me-to-a-random-password
POSTGRES_DB=key_control
APP_VERSION=2.0.1
DATABASE_URL=postgresql+asyncpg://root:change-me-to-a-random-password@postgres:5432/key_control
REDIS_URL=redis://redis:6379/0
CACHE_REDIS_URL=redis://redis:6379/1
CACHE_TTL_SECONDS=10
CACHE_STATISTICS_TTL_SECONDS=60

FRONTEND_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
FRONTEND_BIND_ADDRESS=0.0.0.0
FRONTEND_PORT=3000
BACKEND_BIND_ADDRESS=0.0.0.0
BACKEND_PORT=8000

BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me-to-a-random-password
SESSION_SECRET=change-me-to-a-long-random-secret
FERNET_KEY=replace-with-a-valid-fernet-key
SESSION_COOKIE_SECURE=false

QUEUE_BATCH_RECORDS=1000
QUEUE_BATCH_WAIT_SECONDS=30
QUEUE_CLAIM_IDLE_SECONDS=120
QUEUE_READ_MESSAGES=20
QUEUE_RETRY_LIMIT=5
QUEUE_JOB_MAX_LENGTH=100000
EXPORT_BATCH_SIZE=1000
EXPORT_CRYPTO_WORKERS=4
EXPORT_MAX_CONCURRENT=2
EXPORT_MAX_PENDING_FILES=16
EXPORT_MAX_FILE_BYTES=536870912
EXPORT_MAX_TOTAL_BYTES=1073741824
EXPORT_DOWNLOAD_TTL_SECONDS=600
