POSTGRES_USER=root
POSTGRES_PASSWORD=change-me-to-a-random-password
POSTGRES_DB=key_control
APP_VERSION=2.0.1
DATABASE_URL=postgresql+asyncpg://root:change-me-to-a-random-password@postgres:5432/key_control
REDIS_URL=redis://redis:6379/0

FRONTEND_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
FRONTEND_BIND_ADDRESS=0.0.0.0
FRONTEND_PORT=3000
BACKEND_BIND_ADDRESS=0.0.0.0
BACKEND_PORT=8000

BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me-to-a-random-password
SESSION_SECRET=change-me-to-a-long-random-secret
FERNET_KEY=replace-with-a-valid-fernet-key
SESSION_COOKIE_SECURE=false

BURST_WINDOW_SECONDS=10
BURST_REQUEST_LIMIT=20
